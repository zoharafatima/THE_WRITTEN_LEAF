# Copy to .env (never commit .env). Flask doesn't read this file by itself:
# locally, set these in your terminal before `python app.py`.
#   PowerShell:  $env:DB_PASSWORD="yourpassword"
#   macOS/Linux: export DB_PASSWORD=yourpassword
SECRET_KEY=change-me-to-a-long-random-string
DB_HOST=DB_HOST
DB_USER=the_user
DB_PASSWORD=your-mysql-password
DB_NAME=place_holder
# Set to 1 only in deployment (HTTPS) so session cookies are Secure
PRODUCTION=0
